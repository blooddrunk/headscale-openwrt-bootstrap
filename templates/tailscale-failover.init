#!/bin/sh /etc/rc.common

# TS_FAILOVER_INIT_v1
# Deployed by headscale-openwrt-bootstrap; fingerprint-checked before start.
# The watchdog only switches between profiles registered in
# /etc/config/tailscale-bootstrap - it never logs in and never uses auth keys.

START=95
USE_PROCD=1

start_service() {
        procd_open_instance failover

        procd_set_param command /usr/sbin/tailscale-failover
        procd_set_param respawn
        procd_set_param stdout 1
        procd_set_param stderr 1

        procd_close_instance
}

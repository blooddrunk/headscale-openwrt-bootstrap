#!/bin/sh
# Stateful tailscale CLI emulator.  Prefs live in
# $FAKE_OPENWRT_ROOT/.ts-state/prefs as one line of JSON with the fields the
# scripts parse (ControlURL, CorpDNS, RouteAll, AdvertiseRoutes, ExitNodeID).
# Registered profiles live in $FAKE_OPENWRT_ROOT/.ts-state/profiles, one
# "id|tailnet|name|controlurl" line each; the current profile is the entry
# whose controlurl equals prefs.ControlURL.

ROOT=${FAKE_OPENWRT_ROOT:-}
LOG=${FAKE_LOG:-}
STATE_DIR=$ROOT/.ts-state
PREFS=$STATE_DIR/prefs
PROFILES=$STATE_DIR/profiles
mkdir -p "$STATE_DIR" 2>/dev/null
[ -n "$LOG" ] && printf 'tailscale %s\n' "$*" >> "$LOG"

logged_in() { [ -f "$PREFS" ]; }

prefs_get() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\{0,1\}\([^,\"}\]*\).*/\1/p" "$PREFS" 2>/dev/null | sed -n '1p'
}

write_prefs() {
    # Strip any quotes first: cur_advertised is captured between the array
    # brackets (quotes included), so re-quoting an already-quoted value would
    # double them on the second consecutive `tailscale set`.
    if [ -n "$4" ]; then
        wp_quoted=$(printf '%s\n' "$4" | sed 's/"//g; s/,[[:space:]]*/","/g; s/^/"/; s/$/"/')
    else
        wp_quoted=
    fi
    printf '{"ControlURL":"%s","CorpDNS":%s,"RouteAll":%s,"AdvertiseRoutes":[%s],"ExitNodeID":""}\n' \
        "$1" "$2" "$3" "$wp_quoted" > "$PREFS"
}

profile_host() {
    ph=${1#*://}
    printf '%s\n' "${ph%%/*}"
}

profile_current_line() {
    # prints the db line whose controlurl matches prefs, if any
    [ -f "$PROFILES" ] || return 1
    pc_url=$(prefs_get ControlURL)
    [ -n "$pc_url" ] || return 1
    awk -F'|' -v u="$pc_url" '$4 == u { print; exit }' "$PROFILES"
}

profile_count() {
    [ -f "$PROFILES" ] || { printf 0; return; }
    awk 'END { print NR }' "$PROFILES"
}

profile_remove_current() {
    prc_url=$(prefs_get ControlURL)
    awk -F'|' -v u="$prc_url" '$4 != u { print }' "$PROFILES" > "$PROFILES.tmp"
    mv "$PROFILES.tmp" "$PROFILES"
}

up_login_server=https://controlplane.tailscale.com
up_accept_dns=true
up_accept_routes=false
up_auth_key=
login_server=
prev=
for arg in "$@"; do
    case "$prev" in --login-server) up_login_server=$arg; login_server=$arg ;; esac
    case "$prev" in --auth-key) up_auth_key=$arg ;; esac
    case "$arg" in
        --login-server=*) up_login_server=${arg#--login-server=}; login_server=$up_login_server ;;
        --auth-key=*) up_auth_key=${arg#--auth-key=} ;;
        --accept-dns=*) up_accept_dns=${arg#--accept-dns=} ;;
        --accept-routes=*) up_accept_routes=${arg#--accept-routes=} ;;
    esac
    prev=$arg
done

case "$1 $2" in
    'version '|'version'*)
        printf '%s\n' "${FAKE_TS_VERSION:-$(cat "$STATE_DIR/version" 2>/dev/null || printf 1.98.3)}"
        ;;
    'debug prefs'|'debug prefs'*)
        if logged_in; then
            # Emit pretty-printed JSON like the real CLI (MarshalIndent):
            # the AdvertiseRoutes array spreads across lines, so per-line
            # parsers must flatten first.  Storage stays compact.
            sed -e 's/{/{\n\t/g' -e 's/,/,\n\t/g' -e 's/\([^[]\)\]/\1\n]/g' "$PREFS"
        else
            printf 'cannot load prefs: not logged in\n' >&2
            exit 1
        fi
        ;;
    'status --json'|'status '*)
        if [ "$2" = --json ]; then
            if logged_in; then
                printf '{"Version":"1.98.3","BackendState":"Running","Self":{"HostName":"kwrt"}}\n'
            else
                printf '{"Version":"1.98.3","BackendState":"NeedsLogin","Self":null}\n'
            fi
        else
            if logged_in; then
                printf '100.64.0.1 kwrt\n'
            else
                printf 'Logged out.\n' >&2
                exit 1
            fi
        fi
        ;;
    'ip '*)
        logged_in || exit 1
        printf '100.64.0.1\n'
        ;;
    'switch --list'|'switch --list '*)
        # Newer CLI table: "ID Tailnet Account" with the current account
        # marked by a trailing asterisk.  Columns are padded like the real
        # CLI, so every row (including the header) is re-padded whenever a
        # wider profile joins the list.
        [ -f "$PROFILES" ] || exit 0
        cur=$(prefs_get ControlURL)
        awk -F'|' -v cur="$cur" '
            {
                id[++NDX] = $1; tn[NDX] = $2; ac[NDX] = $3
                star[NDX] = ($4 == cur) ? "*" : ""
                if (length($1) > wid) wid = length($1)
                if (length($2) > wtn) wtn = length($2)
                if (length($3) > wac) wac = length($3)
            }
            END {
                if (NDX == 0) exit
                printf "%-*s  %-*s  %s\n", wid, "ID", wtn, "Tailnet", "Account"
                for (i = 1; i <= NDX; i++)
                    printf "%-*s  %-*s  %s%s\n", wid, id[i], wtn, tn[i], ac[i], star[i]
            }
        ' "$PROFILES"
        ;;
    'switch '*)
        # Positional argument like the real CLI: matched against ID, then
        # tailnet, then account name; the first hit wins.  There is no
        # --id flag, and matching the current profile is a successful no-op.
        logged_in || exit 1
        [ "${FAKE_FAIL_TS_SWITCH:-0}" = 1 ] && { printf 'switch failed (injected)\n' >&2; exit 1; }
        new_url=$(awk -F'|' -v k="$2" '$1 == k { print $4; exit }' "$PROFILES")
        [ -n "$new_url" ] || new_url=$(awk -F'|' -v k="$2" '$2 == k { print $4; exit }' "$PROFILES")
        [ -n "$new_url" ] || new_url=$(awk -F'|' -v k="$2" '$3 == k { print $4; exit }' "$PROFILES")
        [ -n "$new_url" ] || { printf 'no profile matching %s\n' "$2" >&2; exit 1; }
        write_prefs "$new_url" "$(prefs_get CorpDNS)" "$(prefs_get RouteAll)" \
            "$(sed -n 's/.*"AdvertiseRoutes":\[\([^]]*\)\].*/\1/p' "$PREFS")"
        printf 'switched\n'
        ;;
    'login '*|login)
        printf '%s\n' "$*" | grep -q -- '--reset' && { printf 'fixture refuses --reset\n' >&2; exit 1; }
        [ "${FAKE_FAIL_TS_LOGIN:-0}" = 1 ] && { printf 'login failed (injected)\n' >&2; exit 1; }
        case "$up_auth_key" in
            file:*)
                key_file=${up_auth_key#file:}
                [ -f "$key_file" ] || { printf 'invalid auth key: file missing\n' >&2; exit 1; }
                [ "${FAKE_FAIL_AUTH:-0}" = 1 ] && { printf 'invalid auth key (injected)\n' >&2; exit 1; }
                ;;
            '') : ;;
            *) [ "${FAKE_FAIL_AUTH:-0}" = 1 ] && { printf 'invalid auth key (injected)\n' >&2; exit 1; } ;;
        esac
        n=$(profile_count)
        n=$((n + 1))
        login_name=${FAKE_TS_LOGIN_NAME:-user$n}
        login_id=$(printf '01%02d' "$n")
        printf '%s|%s|%s|%s\n' "$login_id" "$(profile_host "$up_login_server")" "$login_name" "$up_login_server" >> "$PROFILES"
        write_prefs "$up_login_server" true false ''
        ;;
    'up '*|'up')
        printf '%s\n' "$*" | grep -q -- '--reset' && { printf 'fixture refuses --reset\n' >&2; exit 1; }
        [ "${FAKE_FAIL_TS_UP:-0}" = 1 ] && { printf 'up failed (injected)\n' >&2; exit 1; }
        case "$up_auth_key" in
            file:*)
                key_file=${up_auth_key#file:}
                [ -f "$key_file" ] || { printf 'invalid auth key: file missing\n' >&2; exit 1; }
                [ "${FAKE_FAIL_AUTH:-0}" = 1 ] && { printf 'invalid auth key (injected)\n' >&2; exit 1; }
                ;;
            '') : ;;
            *) [ "${FAKE_FAIL_AUTH:-0}" = 1 ] && { printf 'invalid auth key (injected)\n' >&2; exit 1; } ;;
        esac
        [ "${FAKE_DIFFERENT_CONTROLURL:-0}" = 1 ] && up_login_server=https://login.tailscale.com
        write_prefs "$up_login_server" "$up_accept_dns" "$up_accept_routes" ''
        # First login creates the "default" profile, replacing any previous db.
        printf '0101|%s|default|%s\n' "$(profile_host "$up_login_server")" "$up_login_server" > "$PROFILES"
        ;;
    'set '*)
        logged_in || { printf 'set: not logged in\n' >&2; exit 1; }
        [ "${FAKE_FAIL_TS_SET:-0}" = 1 ] && { printf 'set failed (injected)\n' >&2; exit 1; }
        cur_url=$(prefs_get ControlURL)
        cur_dns=$(prefs_get CorpDNS)
        cur_routes=$(prefs_get RouteAll)
        cur_advertised=$(sed -n 's/.*"AdvertiseRoutes":\[\([^]]*\)\].*/\1/p' "$PREFS")
        new_dns=$cur_dns
        new_routes=$cur_routes
        new_advertised=$cur_advertised
        for arg in "$@"; do
            case "$arg" in
                --accept-dns=*) new_dns=${arg#--accept-dns=} ;;
                --accept-routes=*) new_routes=${arg#--accept-routes=} ;;
                --advertise-routes=*) new_advertised=${arg#--advertise-routes=} ;;
            esac
        done
        write_prefs "$cur_url" "$new_dns" "$new_routes" "$new_advertised"
        ;;
    'logout'|'logout '*)
        [ -f "$PROFILES" ] && profile_remove_current
        if [ -f "$PROFILES" ] && [ -s "$PROFILES" ]; then
            next_url=$(awk -F'|' 'NR == 1 { print $4; exit }' "$PROFILES")
            write_prefs "$next_url" "$(prefs_get CorpDNS)" "$(prefs_get RouteAll)" ''
        else
            rm -f "$PREFS"
        fi
        ;;
    'netcheck'|'netcheck '*)
        printf 'DERP relay "tok"\n'
        ;;
    'ping'|'ping '*)
        printf 'pong from via DERP(tok)\n'
        ;;
    *) exit 0 ;;
esac

#!/bin/sh
# Fixture pgrep: tailscaled is considered not running (fixture namespace
# never starts real daemons).  FAKE_TAILSCALED_RUNNING=1 flips it, and the
# marker the fixture ubus writes on `service delete` flips it back (procd
# terminating the instance).
[ -f "${FAKE_OPENWRT_ROOT:-}/.stock-daemon-stopped" ] && exit 1
[ "${FAKE_TAILSCALED_RUNNING:-0}" = 1 ] && exit 0
exit 1

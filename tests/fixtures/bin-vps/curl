#!/bin/sh
# Fixture curl: download URLs to a file, or answer health probes with a code.

LOG=${FAKE_LOG:-}
[ -n "$LOG" ] && printf 'curl %s\n' "$*" >> "$LOG"

url=
out=
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o|--output) out=$2; shift 2 ;;
        --write-out) shift 2 ;;
        -*) shift ;;
        *) url=$1; shift ;;
    esac
done

if [ -n "$out" ] && [ "$out" != /dev/null ]; then
    case "$url" in
        https://github.com/juanfont/headscale/releases/download/*)
            deb_name=${url##*/}
            deb_version=$(printf '%s\n' "$deb_name" | sed -n 's/^headscale_\([0-9][0-9.]*\)_linux_.*/\1/p')
            [ "${FAKE_MISMATCH_DEB:-0}" = 1 ] && deb_version=9.9.9
            printf 'FAKEDEB %s\n' "$deb_version" > "$out"
            ;;
        https://api.github.com/repos/juanfont/headscale/releases*)
            printf '%s\n' "${FAKE_RELEASE_TAGS:-v0.29.3 v0.29.0 v0.28.4 v0.28.0 v0.27.4 v0.27.0 v0.26.1}" |
                awk '{ for (i = 1; i <= NF; i++) printf "{\"tag_name\":\"%s\",\"prerelease\":false}", $i }' > "$out"
            ;;
        *)
            printf 'FAKEBODY\n' > "$out"
            ;;
    esac
    exit 0
fi

case "$url" in
    http://127.0.0.1*|http://localhost*)
        # FAKE_HEALTH_DELAY=N: the first N local /health probes answer 000,
        # emulating a headscale that is still initializing under a
        # Type=simple unit.  The counter file survives across the separate
        # fixture curl processes of one script run.
        if [ -n "${FAKE_HEALTH_DELAY:-}" ]; then
            probes_file=${FAKE_VPS_ROOT:-/tmp}/.health-probes
            probes=$(cat "$probes_file" 2>/dev/null || printf 0)
            probes=$((probes + 1))
            printf '%s\n' "$probes" > "$probes_file" 2>/dev/null
            if [ "$probes" -le "$FAKE_HEALTH_DELAY" ]; then
                printf '000\n'
                exit 0
            fi
        fi
        printf '%s\n' "${FAKE_LOCAL_HEALTH:-200}"
        ;;
    https://*)
        printf '%s\n' "${FAKE_PUBLIC_HEALTH:-200}"
        ;;
    *)
        printf '%s\n' "${FAKE_HTTP_CODE:-200}"
        ;;
esac

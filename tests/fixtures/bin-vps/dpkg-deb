#!/bin/sh
# Fixture dpkg-deb: report Package/Version fields for the fake .deb files the
# fixture curl writes ("FAKEDEB <version>" first line).

LOG=${FAKE_LOG:-}
[ -n "$LOG" ] && printf 'dpkg-deb %s\n' "$*" >> "$LOG"

# Syntax: dpkg-deb --field FILE [FIELD...]
deb_file=
fields=
seen_field_flag=
for arg in "$@"; do
    if [ "$arg" = "--field" ] || [ "$arg" = "-f" ]; then
        seen_field_flag=1
        continue
    fi
    case "$arg" in
        -*) continue ;;
    esac
    if [ -z "$deb_file" ]; then
        [ -f "$arg" ] && deb_file=$arg
    else
        fields="$fields $arg"
    fi
done

[ -n "$deb_file" ] || { printf 'dpkg-deb: no readable package file\n' >&2; exit 1; }
deb_version=$(sed -n 's/^FAKEDEB //p' "$deb_file" | sed -n '1p')
[ -n "$deb_version" ] || { printf 'dpkg-deb: not a fixture package\n' >&2; exit 1; }

# Mirror real dpkg-deb --field behavior: a single requested field prints the
# bare value, multiple fields print "Field: value" lines.
[ -z "$fields" ] && fields=' Package Version'
field_count=0
for field in $fields; do field_count=$((field_count + 1)); done
for field in $fields; do
    case "$field" in
        Package) value=headscale ;;
        Version) value=$deb_version ;;
        *) value= ;;
    esac
    if [ "$field_count" -gt 1 ]; then
        printf '%s: %s\n' "$field" "$value"
    else
        printf '%s\n' "$value"
    fi
done
